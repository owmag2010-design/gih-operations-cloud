# GIH Operations Cloud environment template. Copy to .env.local for development.
# Never commit real values.

# Application connection: the restricted gih_app role (row-level security applies).
DATABASE_URL=postgres://gih_app:CHANGE_ME@localhost:5432/gih_dev

# Schema owner: migrations and seed only. Do not set this in the hosting platform.
MIGRATION_DATABASE_URL=postgres://gih:CHANGE_ME@localhost:5432/gih_dev

# Public base URL used in invitation and password-reset links.
APP_URL=http://localhost:3000

# 32 random bytes, base64: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Shared secret for signed intake webhooks: openssl rand -hex 32
INTAKE_WEBHOOK_SECRET=

# Resend. Leave empty to record emails as "not configured" instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Global Immigration Hub <hello@thegih.com>"
